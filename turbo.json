{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_URL", "VITE_WS_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "RUN_DOCKER_TESTS",
        "JUDGE_SECRET",
        "RUNNER_IMAGE",
        "WORK_DIR",
        "MAX_CONCURRENT_JOBS",
        "MAX_QUEUE_SIZE"
      ],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "NODE_ENV",
        "VITE_API_URL",
        "VITE_WS_URL",
        "JUDGE_SECRET",
        "RUNNER_IMAGE",
        "WORK_DIR",
        "MAX_CONCURRENT_JOBS",
        "MAX_QUEUE_SIZE"
      ]
    }
  }
}
