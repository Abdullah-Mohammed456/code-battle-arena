{
  "private": true,
  "type": "module",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "eslint": "10.9.1",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  },
  "name": "@repo/server",
  "scripts": {
    "dev": "bun run db:generate && tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "bun run db:generate && tsc -p tsconfig.build.json",
    "typecheck": "bun run db:generate && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "bun run db:generate && bun test src",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/.bin/prisma migrate deploy",
    "test:integration": "bun run db:generate && bun run db:migrate && RUN_DATABASE_TESTS=1 bun test src/db/users.integration.test.ts",
    "db:migrate:dev": "node --env-file-if-exists=.env ./node_modules/.bin/prisma migrate dev"
  },
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@repo/shared": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  }
}
