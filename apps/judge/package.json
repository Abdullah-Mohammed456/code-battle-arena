  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "eslint": "10.9.1",
    "typescript": "^7.0.2",
    "@repo/typescript-config": "workspace:*"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1"
  }
}
